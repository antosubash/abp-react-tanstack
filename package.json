    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.169.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "iron-session": "^9.1.0",
    "lucide-react": "^1.77.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.261103-rc",
    "openid-client": "^6.9.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/devtools-vite": "^0.8.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "msw": "^3.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "web-vitals": "^6.2.3"
  }
}
