{
  "name": "abp-react-tanstack",
  "version": "0.0.21",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run --coverage && playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint && node scripts/check-file-size.js && node scripts/check-file-naming.js",
    "lint:fix": "biome lint --write --unsafe .",
    "check": "biome check && node scripts/check-file-size.js && node scripts/check-file-naming.js",
    "check-file-size": "node scripts/check-file-size.js",
    "check-file-naming": "node scripts/check-file-naming.js",
    "find-unused-files": "node scripts/find-unused-files.js",
    "typecheck": "tsc --noEmit",
    "generate-api": "openapi-ts --file hey-api.config.ts",
    "docker:build": "docker build -t abp-react-tanstack .",
    "docker:run": "docker run -p 3000:3000 abp-react-tanstack",
    "docker:up": "docker build -t abp-react-tanstack . && docker run -p 3000:3000 abp-react-tanstack",
    "docker:compose:up": "docker-compose up --build",
    "docker:compose:down": "docker-compose down"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
